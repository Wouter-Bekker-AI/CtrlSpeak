#!/usr/bin/env bash
# External command-provider adapter; resolve one immutable release per invocation.
set -euo pipefail
umask 077
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
service_root=$(dirname -- "${script_dir}")
helper_python=${CTRLSPEAK_HELPER_PYTHON:-"${service_root}/.helper-venv/bin/python"}
export PYTHONPATH="${service_root}"
if [[ ${1:-} == --version || ${1:-} == --self-test ]]; then
  exec "${helper_python}" -m app.stt_client "$@"
fi

# The user-service drop-in is the source of truth for LAN bind/auth. Explicit
# environment variables remain useful for tests or a differently hosted API.
service_override=${WHISPER_SERVICE_OVERRIDE:-"${XDG_CONFIG_HOME:-${HOME}/.config}/systemd/user/whisper-transcription.service.d/lan.conf"}
api_host=${WHISPER_API_HOST:-127.0.0.1}
api_token=${WHISPER_BEARER_TOKEN:-}
if [[ -r "${service_override}" ]]; then
  while IFS= read -r setting; do
    case "${setting}" in
      Environment=WHISPER_BIND_HOST=*)
        api_host=${WHISPER_API_HOST:-${setting#Environment=WHISPER_BIND_HOST=}}
        ;;
      Environment=WHISPER_BEARER_TOKEN=*)
        api_token=${WHISPER_BEARER_TOKEN:-${setting#Environment=WHISPER_BEARER_TOKEN=}}
        ;;
    esac
  done < "${service_override}"
fi
profile_env=${HERMES_HOME:-${HOME}/.hermes}/.env
if [[ -r "${profile_env}" ]]; then
  set -a
  # Existing protected profile contract; never print or copy this environment.
  source "${profile_env}"
  set +a
fi
export CTRLSPEAK_GATEWAY_URL=${CTRLSPEAK_GATEWAY_URL:-${WHISPER_API_URL:-"http://${api_host}:8765"}}
export CTRLSPEAK_CLIENT_TOKEN=${CTRLSPEAK_CLIENT_TOKEN:-${api_token}}
exec "${helper_python}" -m app.stt_client "$@"
