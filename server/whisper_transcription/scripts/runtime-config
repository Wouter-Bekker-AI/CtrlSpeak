#!/bin/sh
# Shared runtime validation. This file is sourced by run-service and is also
# intentionally side-effect free so configuration can be checked in tests.

whisper_bind_host() {
  printf '%s\n' "${WHISPER_BIND_HOST:-${WHISPER_HOST:-127.0.0.1}}"
}

whisper_is_loopback_bind_host() (
  host=$1
  case "$host" in
    localhost|::1)
      return 0
      ;;
    127.*)
      ;;
    *)
      return 1
      ;;
  esac

  old_ifs=$IFS
  IFS=.
  set -- $host
  IFS=$old_ifs
  [ "$#" -eq 4 ] || return 1
  [ "$1" = 127 ] || return 1
  for octet in "$@"; do
    case "$octet" in
      ''|*[!0-9]*) return 1 ;;
    esac
    [ "$octet" -le 255 ] || return 1
  done
)

whisper_validate_runtime_config() {
  bind_host=$(whisper_bind_host)
  whisper_is_loopback_bind_host "$bind_host" && return 0
  if [ -z "${WHISPER_BEARER_TOKEN:-}" ]; then
    printf '%s\n' \
      'Refusing non-loopback binding: configure WHISPER_BEARER_TOKEN first.' >&2
    return 64
  fi
}

whisper_print_runtime_config() {
  device=${WHISPER_DEVICE:-cuda}
  if [ -n "${WHISPER_COMPUTE_TYPE:-}" ]; then
    compute_type=$WHISPER_COMPUTE_TYPE
  elif [ "$device" = cuda ]; then
    compute_type=float16
  else
    compute_type=int8
  fi
  printf 'host=%s\n' "$(whisper_bind_host)"
  printf 'port=%s\n' "${WHISPER_PORT:-8765}"
  printf 'model=%s\n' "${WHISPER_MODEL_NAME:-large-v3-turbo}"
  printf 'device=%s\n' "$device"
  printf 'compute_type=%s\n' "$compute_type"
  printf 'cpu_threads=%s\n' "${WHISPER_CPU_THREADS:-4}"
  printf 'model_workers=%s\n' "${WHISPER_NUM_WORKERS:-1}"
  if [ -n "${WHISPER_BEARER_TOKEN:-}" ]; then
    printf 'bearer_token=configured\n'
  else
    printf 'bearer_token=not-configured\n'
  fi
}

if [ "${0##*/}" = "runtime-config" ]; then
  whisper_validate_runtime_config
  whisper_print_runtime_config
fi
