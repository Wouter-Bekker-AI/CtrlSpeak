#!/usr/bin/env bash
set -euo pipefail

SERVICE_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
UNIT_SOURCE="${SERVICE_ROOT}/systemd/whisper-transcription.service"
UNIT_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/systemd/user"
UNIT_TARGET="${UNIT_DIR}/whisper-transcription.service"

mkdir -p "${UNIT_DIR}"
sed "s|@SERVICE_ROOT@|${SERVICE_ROOT}|g" "${UNIT_SOURCE}" > "${UNIT_TARGET}"
chmod 600 "${UNIT_TARGET}"
systemctl --user daemon-reload
systemctl --user enable whisper-transcription.service

echo "Installed ${UNIT_TARGET}"
echo "Configure a protected systemd drop-in before LAN use; see README.md."
echo "Start with: systemctl --user start whisper-transcription.service"
