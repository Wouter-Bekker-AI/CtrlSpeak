{
  "name": "tts_preprocessing_agent",
  "description": "Reformats profile-style replies into natural speech before synthesis",
  "llm_model": "gemma3:1b",
  "llm_url": "http://localhost:11434/api/chat",
  "ollama_options": {
    "temperature": 0.0,
    "top_p": 1.0,
    "repeat_penalty": 1.0,
    "mirostat": 0,
    "seed": 0,
    "stop": ["\n\n"]
  },
  "prompt_file": "system_prompt.txt",
  "preamble": "system"
}
